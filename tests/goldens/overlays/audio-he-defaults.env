CHATTERBOX_PORT=9000
CONTINUATION_TOOL_HOLD_MS=500
CONTINUATION_WINDOW_MS=0
GENERATE_STREAM=true
HF_CACHE=${HOME:-/root}/.cache/huggingface
HOME=/root
OPENAI_MODEL=multimodal
PARAKEET_PORT=9002
PHONIKUD_MODEL_PATH=
REALTIME_LANGUAGE=he
REPLY_FIRST_CLAUSE_MIN_CHARS=24
STT_LANGUAGE=he
STT_MIN_AVG_LOGPROB=-0.35
STT_MODEL=ivrit-ai/whisper-large-v3-turbo
STT_RUNTIME=transformers
TOOL_WAIT_TIMEOUT_MS=120000
TTS_DEBUG_TEXT=
TTS_DIACRITIZE=auto
TTS_LANGUAGE=he
TTS_MAX_RETRIES=2
TTS_MODEL=ResembleAI/chatterbox
TTS_RUNTIME=chatterbox-multilingual
TTS_TEMPERATURE=0.3
VAD_EAGER_MS=0
