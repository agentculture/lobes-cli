CHATTERBOX_PORT=9000
CONTINUATION_TOOL_HOLD_MS=500
CONTINUATION_WINDOW_MS=0
GENERATE_STREAM=true
HF_CACHE=${HOME:-/root}/.cache/huggingface
HOME=/root
OPENAI_MODEL=multimodal
PARAKEET_PORT=9002
PHONIKUD_MODEL_PATH=
REALTIME_LANGUAGE=he
REPLY_FIRST_CLAUSE_MIN_CHARS=24
STT_COMPRESSION_RATIO_MAX=2.4
STT_LANGUAGE=he
STT_LOGPROB_STAT=median
STT_MAX_WORD_RUN=4
STT_MIN_AVG_LOGPROB=-0.35
STT_MODEL=ivrit-ai/whisper-large-v3-turbo
STT_NO_REPEAT_NGRAM_SIZE=6
STT_REPETITION_PENALTY=1.0
STT_RUNTIME=transformers
STT_TEMPERATURE_FALLBACK=0.2,0.4
STT_VAD=auto
STT_VAD_MIN_SPEECH_MS=250
STT_VAD_THRESHOLD=0.5
TOOL_WAIT_TIMEOUT_MS=120000
TTS_DEBUG_TEXT=
TTS_DIACRITIZE=auto
TTS_LANGUAGE=he
TTS_MAX_RETRIES=2
TTS_MODEL=ResembleAI/chatterbox
TTS_RUNTIME=chatterbox-multilingual
TTS_TEMPERATURE=0.3
VAD_EAGER_MS=0
VAD_MIN_LEVEL_PCT=0
