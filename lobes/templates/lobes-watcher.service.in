# lobes host watcher (lane-safety contract, section 5).
#
# Installed by `lobes watcher install --apply`; removed by
# `lobes watcher uninstall --apply` (the manifest in the deployment dir lists
# exactly the files written). It polls the deployment's lane-state/*.gated
# markers and runs the machine CLI's drop-caches at most once per
# LOBES_WATCHER_MIN_INTERVAL_S. It never runs a docker command.
#
# PATH is captured at install time so the machine CLI (spark/thor/orin, often
# under ~/.local/bin) resolves the same way it did for the installer.
#
# This is a HOST unit template, not a compose scaffold file: `lobes init` never
# copies it into a deployment dir.
[Unit]
Description=lobes host watcher (page-cache clear for memory-gated lanes)
After=network.target

[Service]
Type=simple
@USER_LINE@@ENV_LINE@ExecStart=@EXEC_START@
Restart=on-failure
RestartSec=10

[Install]
WantedBy=@WANTED_BY@
