# lobes decider sidecar, vLLM variant — DECIDER_BACKEND=clef-vllm
# (lobes/decider_sidecar/clef_vllm.py, orin-decision-models t21). Clef's backbone
# runs IN-PROCESS in vLLM's pooling runner (a compressed-tensors W4A16 build loads
# through vLLM's own kernels, no engine patch); Cloudflare's joint schema head,
# loaded from the served repo's own joint_schema_model.py, scores the options in
# bf16. Same POST /v1/systemone response as the `clef` backend; text-only.
#
# Base: vllm/vllm-openai:v0.31.0-ubuntu2404, pinned by its MULTI-ARCH index
# digest (#310 R2, confirmed against Docker Hub's tag record): the index carries
# linux/arm64 and linux/amd64. It is the same image the fleet lanes now pin. Whether the arm64 build carries sm_87 (Jetson AGX Orin) kernels is
# UNVALIDATED (#108) until t13 boots it. vLLM, torch, transformers, safetensors
# and huggingface_hub all come from the base image and are deliberately NOT
# reinstalled — a newer transformers here could break the vLLM it ships with.
#
# No EXPOSE and no port publishing: the container listens on DECIDER_PORT
# (default 8000) inside its network only; the gateway is the sole way in and the
# compose file decides exposure. MODEL_GEAR_VERSION pins the sidecar module to
# the lobes-cli release that scaffolded the deployment. Required.
ARG DECIDER_VLLM_BASE_IMAGE=vllm/vllm-openai@sha256:3fb023cc987cc7c2bca7ca14c1e0aff5ae06bd9431bf07773731ce7e8a682460
FROM ${DECIDER_VLLM_BASE_IMAGE}
ARG MODEL_GEAR_VERSION
# Dev lane — same contract as Dockerfile.decider: the .devN wheel is fetched
# --no-deps from THAT index only, then the normal install resolves the extra's
# deps from real PyPI. Empty = no-op.
ARG LOBES_DEV_INDEX_URL=
ENV DECIDER_BACKEND=clef-vllm
RUN if [ -n "${LOBES_DEV_INDEX_URL}" ]; then \
        uv pip install --system --no-deps --index-url "${LOBES_DEV_INDEX_URL}" \
            "lobes-cli==${MODEL_GEAR_VERSION}"; \
    fi \
    && uv pip install --system "lobes-cli[decider-sidecar]==${MODEL_GEAR_VERSION}"
# The base image's ENTRYPOINT is `vllm serve`; replace it with the sidecar.
ENTRYPOINT ["python3", "-m", "lobes.decider_sidecar.server"]
