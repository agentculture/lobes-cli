# Copy to .env (lobes init --fleet does this) and adjust. Consumed by the fleet
# docker-compose.yml: the always-warm Qwen generate primary, two tiny co-resident
# embedding + reranker gears, and a stdlib gateway that fronts them on one
# OpenAI-compatible port.
#
# The gateway routes by task family (generate / embed / score / rerank) — an
# unknown/missing `model` defaults to GATEWAY_DEFAULT_MODEL (the primary). There
# is one generate backend by default: the primary keeps its load-tested headroom
# (util 0.6, full 256K context, ~75 GiB) while the ~0.6B embed/rerank gears
# (util 0.06 each) co-reside in the GB10's 128 GB unified memory.
#
# TO ADD A WARM FALLBACK, define a vllm-fallback service in the compose, set
# FALLBACK_URL + FALLBACK_SERVED_NAME on the gateway, and drop both GPU_MEM_UTIL
# values so they sum well under 1.0. CO-RESIDENCE NEEDS HEADROOM: live-validated
# 2026-05-30, two ~30B NVFP4 models do NOT co-fit on a GB10 also running other
# services. See docs/gateway-fleet.md "Live validation findings".

# HuggingFace token. Required only for gated repos — accept the license first,
# then paste a read token. Injected into the vLLM backend(s), not the gateway.
# SECURITY: the primary serves with --trust-remote-code (custom modeling code) and
# this token is injected into that container. The default checkpoint is public —
# leave HF_TOKEN empty; for a gated repo use a minimal-scope read-only token.
HF_TOKEN=

# Host path for the HuggingFace weight cache (shared by any vLLM backend). Defaults
# to ~/.cache/huggingface (or /root/.cache/huggingface if $HOME is unset).
HF_CACHE=

# Host dir for durable, restart-surviving logs (issue #50). Each vLLM gear tees its
# stdout+stderr here as per-boot files ({primary,embed,rerank}-<boot>.log) via
# mg-logwrap, so a crash trace survives restart/recreate. Read with `lobes logs`.
# Default ./logs next to docker-compose.yml; set an absolute path to pin a disk.
MODEL_GEAR_LOG_DIR=

# Shared vLLM nightly image for the six Qwen-lane gears (primary/embed/
# embed-deep/rerank/hand/worker) — pinned by digest so all six stay on ONE
# engine. Set once here; a future digest bump is a one-line change instead of
# editing six services. See docs/vllm-nightly-migration.md.
#
# BUMPED (t5 of devague plan lobes-adopts-qwen3.8-27b-nvfp4-as-cortex-p): the
# official Docker Hub nightly built 2026-08-19, resolving to vLLM
# 0.26.1rc1.dev942+g5a4c8d992 — see the t2 engine spike,
# docs/evidence/2026-08-19-spike-qwen3.8-official-nightly-spark.txt. This now
# DIVERGES from the Gemma multimodal gear's Dockerfile.vllm-gemma4, which
# stays pinned OLD (0.23.1rc1.dev672) deliberately — operator decision, not
# re-validated against the new nightly. Pre-bump digest:
# sha256:7c5a10e9a8b3c8642f4d0463a41215176c0dd834b4f0967287c7e3e517cf1be9.
VLLM_NIGHTLY_IMAGE=vllm/vllm-openai@sha256:8bd082c274fae025b7079498fe1da65182ba1d4c2188c0f5a68c1042c38c3695

# --- Primary backend (the gateway's default model) ------------------------
# The MTP speculative-decoding 27B (text-only): ~2.4x decode vs the archived
# baseline, tool calling + reasoning verified 2026-05-31. The MTP serve flags
# (--speculative-config / --trust-remote-code / --language-model-only /
# --tokenizer override) are baked into the fleet compose's vllm-primary service.
PRIMARY_MODEL=unsloth/Qwen3.8-27B-NVFP4
PRIMARY_SERVED_NAME=unsloth/Qwen3.8-27B-NVFP4
PRIMARY_MAX_MODEL_LEN=131072                 # the primary now serves its full 128K native context — the 27B KV cache is util-bound, not context-bound, so 64K->128K trades concurrency at the same memory footprint. See GPU budget below.
PRIMARY_GPU_MEM_UTIL=0.30                    # live-validated 2026-07-03 (#81 t12): cortex@128K at util 0.30 = 3.58x concurrency (18.02 GiB / 468,886-token KV), healthy co-resident with senses@32K. See GPU budget below.
PRIMARY_MAX_NUM_SEQS=2                        # MTP cap — 4 OOMs at n=3/high context (see docs/qwen3.6-27b-text-nvfp4-mtp.md)
                                              # NOTE: this is vLLM's OOM safety cap, NOT a measured serving capacity — see
                                              # PRIMARY_MAX_ACTIVE further down (capacity-relative pool routing, #199)
PRIMARY_TOOL_CALL_PARSER=qwen3_coder_thinking  # reasoning-aware qwen3_coder variant (t2); loaded via the
                                              # --tool-parser-plugin mount (lobes.vllm_plugins package,
                                              # materialised by `lobes init`). Falls back to plain
                                              # upstream `qwen3_coder` if you override this value.
PRIMARY_QUANTIZATION=compressed-tensors      # the checkpoint's OWN quant_method (mixed fp8 + nvfp4); `modelopt` fails on a quant-method mismatch
# fp8 KV needs calibrated k_scale/v_scale in the checkpoint; this NVFP4 re-export
# ships none (kv_cache_quant_algo: null), so fp8 trips `assert layer.k_scale > 0.0`
# on some vLLM nightlies/hardware. Shipped default STAYS fp8 (GB10 behavior
# unchanged). Thor (sm_110) sets: PRIMARY_KV_CACHE_DTYPE=auto (see #109).
PRIMARY_KV_CACHE_DTYPE=fp8
# hf-overrides JSON merged into the checkpoint's own config at load. Empty by
# default (the compose template's own ${VAR:-{}} falls back to a documented
# vLLM no-op — an empty JSON dict overrides nothing, byte-equivalent to
# omitting the flag). Only the spark-lobe deployment shape sets this today,
# to a YaRN rope_parameters patch reaching a 1M-token window — see
# lobes/profiles/builtin_shapes/spark-lobe.toml's [overrides.cortex]. Leave
# commented out on a plain `lobes init --fleet` deployment.
# PRIMARY_HF_OVERRIDES={"text_config": {"rope_parameters": {"rope_type": "yarn", "factor": 4.0, "original_max_position_embeddings": 262144, "mrope_interleaved": true, "mrope_section": [11, 11, 10], "partial_rotary_factor": 0.25, "rope_theta": 10000000}}}
# vLLM refuses --max-model-len beyond the checkpoint's own declared ceiling
# unless this is set. Pairs with PRIMARY_HF_OVERRIDES above — only needed by
# a shape serving a YaRN-scaled window past the checkpoint's native 262144.
# PRIMARY_ALLOW_LONG_MAX_MODEL_LEN=1

# PRIMARY_SPECULATIVE_CONFIG — the cortex lane's MTP off-switch (the same
# mechanism as MULTIMODAL_SPECULATIVE_CONFIG below, now also wired onto
# vllm-primary and vllm-worker). LEAVE IT UNSET (commented out, as it is here)
# for the shipped behaviour: native self-hosted MTP speculative decoding — the
# 27B checkpoint's own baked-in draft head, no external draft-model key.
# Measured on the GB10 2026-07-31: 62-67% draft acceptance, decode up to 19.0
# tok/s. The default lives in the vllm-primary command in docker-compose.yml.
#
# Setting it to the EMPTY string drops speculative decoding entirely — the flag
# is omitted from the vLLM argv, not blanked:
#
#   PRIMARY_SPECULATIVE_CONFIG=
#
# That is the recorded fallback for a Jetson AGX Thor (sm_110) box serving
# cortex: the 8bd082 nightly ships no kernel image for
# fused_gdn_decode_post_conv_mtp on sm_110, so MTP must come off entirely there
# while the non-MTP GDN path works — see
# docs/evidence/2026-08-20-accept-cortex-local-thor.txt. Clear
# PRIMARY_MAX_NUM_SEQS too in that case; it exists only to cap MTP's OOM risk.
# Mind the difference between unset and empty — this knob uses compose's
# dash-only default operator (`${VAR-default}`, not `${VAR:-default}`)
# precisely so an empty value means "off" instead of "use the default".
#
# To RETARGET the draft rather than disable it, BOTH quoting layers matter
# (the value crosses compose's dotenv parser first, then its shell-lexer).
# This form works — it is what `lobes init --shape spark-lobe` renders, and it
# was checked against `docker compose config` on the real template:
#
#   PRIMARY_SPECULATIVE_CONFIG="'--speculative-config={\"method\":\"dspark\",\"model\":\"RadixArk/Qwen3.8-27B-DSpark\",\"revision\":\"85ef153be924f17ce4bf62726954eeaa4a73e854\",\"num_speculative_tokens\":7}'"
#
# Bare single quotes and no quotes at all BOTH fail, and both fail SILENTLY:
# dotenv strips the outer quotes, the shell-lexer then eats the JSON's own
# double quotes, and vLLM is handed `{method:dspark,...}` — an invalid config
# whose boot failure points nowhere near the .env line that caused it. Always
# verify a retarget from the container's rendered argv (`docker inspect`),
# never from this file.

# --- Fallback backend (optional; none by default) -------------------------
# The fleet ships one generate backend. To add a warm generate fallback, define a vllm-fallback
# service in the compose and set FALLBACK_URL + FALLBACK_SERVED_NAME below (the
# gateway adds a second backend only when those are present), then lower both
# GPU_MEM_UTIL values. The archived dense Mistral-Small-3.2-24B (NVFP4) fallback
# config lives in git history and docs/mistral-small-3.2-24b-nvfp4.md; Mistral
# remains a selectable catalog candidate (`lobes overview --list`).
# FALLBACK_URL=http://vllm-fallback:8000
# FALLBACK_SERVED_NAME=

# --- Embedding + reranker gears (co-resident, tiny footprint) --------------
# Two 0.6B gears served alongside the primary. Each gets util 0.06 (~7 GiB
# budget apiece; 0.025 OOMs the pooling cache blocks — load-tested 2026-06-19);
# the primary + both gears sum well under 1.0 on the 128 GB GB10. Context is
# capped at 8192 tokens to keep KV cache tiny — short-context embed/rerank
# workloads, not generation.
#
# Embedding: Qwen3-Embedding-0.6B — 1024-dim Matryoshka embeddings (dims:
# 32/64/128/256/512/768/1024 selectable via the API truncation parameter).
# The is_matryoshka hf-override is baked into the compose service command.
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBED_SERVED_NAME=Qwen/Qwen3-Embedding-0.6B
EMBED_MAX_MODEL_LEN=8192
# 0.06 load-tested 2026-06-19; 0.025 fails with "No available memory for the cache
# blocks" (vLLM's pooling runner still reserves a cache-block budget).
EMBED_GPU_MEM_UTIL=0.06
# Internal URL the gateway uses to reach the embedding backend.
EMBED_URL=http://vllm-embed:8000
# Attention backend for the pooling runner. "auto" (the shipped default) is
# byte-equivalent to omitting --attention-config entirely — vLLM's
# AttentionConfig.backend treats the string "auto" as its own automatic-
# selection sentinel (vllm/config/attention.py). Thor (sm_110) sets:
# EMBED_ATTENTION_BACKEND=TRITON_ATTN — the auto-picked FLASH_ATTN pooling
# path hangs the forward pass there (VLLM_ATTENTION_BACKEND is gone on this
# nightly; AttentionConfig is the only honoured knob). See #109/#105.
EMBED_ATTENTION_BACKEND=auto

# ---------------------------------------------------------------------------
# The "deep" embedding slot (opt-in) — Qwen3-Embedding-4B.
#
# A SECOND embedding gear beside the 0.6B above, not a replacement. The 0.6B
# keeps the latency-sensitive hot path (~28 ms warm; every ingest, every
# recall); the deep slot is what you reach for when retrieval fidelity outranks
# speed (MTEB multilingual mean 69.45 vs the 0.6B's ~64.3). Addressed through
# the gateway as model="embed-deep".
#
# The slot is named for its JOB, not its model — a later swap to a larger
# checkpoint keeps the alias stable. It does NOT keep the index: see the
# vector-space warning below.
#
# *** THE TWO EMBEDDERS ARE NOT INTERCHANGEABLE. ***
# Their outputs live in different vector spaces. A corpus indexed with one can
# only be queried with the same one — mixing them silently returns garbage
# similarity rather than an error. Truncating the 4B to 1024 dims via
# Matryoshka does NOT make it comparable to the 0.6B's 1024. Adopting the deep
# slot for an existing index therefore means a FULL re-embed of that corpus.
#
# Activate with: docker compose --profile embed-deep up -d
# OR add "embed-deep" to COMPOSE_PROFILES in .env.
# Then uncomment EMBED_DEEP_BASE_URL so the gateway routes the "embed-deep"
# alias here. Leaving it unset means the alias does not exist at all (a request
# for it is an unknown model) — deliberately NOT a fallback to the 0.6B.
EMBED_DEEP_MODEL=Qwen/Qwen3-Embedding-4B
EMBED_DEEP_SERVED_NAME=Qwen/Qwen3-Embedding-4B
# EMBED_DEEP_BASE_URL=http://vllm-embed-deep:8000   # uncomment to activate gateway routing
EMBED_DEEP_MAX_MODEL_LEN=8192
# MEASURED on the GB10 2026-07-20 (docs/evidence/2026-07-20-accept-embed-deep-gb10.txt):
# boots and serves at 0.11 co-resident with the full spark-lobe fleet — weights
# 7.56 GiB, KV 11.34 GiB / 82,592 tokens, CUDA graph pool 0.84 GiB. NOTE vLLM's
# allocation (19.74 GiB) does NOT reconcile with util x total (13.39 GiB) on this
# unified-memory card — the knob is empirical here, as it was for spark-lobe's
# 0.44. Also: VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0 (set on the service)
# means graph memory is unaccounted during KV allocation; watch for OOM under
# pressure. UNVALIDATED on sm_110/Thor (#108).
EMBED_DEEP_GPU_MEM_UTIL=0.11
# MUST be set by hand on sm_110 (Thor). The SM_110 trait that forces TRITON_ATTN
# for embedder/reranker keys off PROFILE ROLE names, and embed-deep is a gear, not
# a role — no trait reaches it. On sm_110 "auto" resolves to the FLASH_ATTN pooling
# path that HANGS the forward pass while /health stays green (#105). Set
# EMBED_DEEP_ATTENTION_BACKEND=TRITON_ATTN there. The GB10 run above used
# FLASH_ATTN and was fine (sm_121); Thor is UNVALIDATED.
EMBED_DEEP_ATTENTION_BACKEND=auto

# Reranker: Qwen3-Reranker-0.6B — sequence classification reranker.
# The Qwen3ForSequenceClassification hf-override + classifier_from_token
# ["no","yes"] are baked into the compose service command (required for the
# reranker head; vLLM --runner pooling --convert classify picks up the
# classification logits).
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANK_SERVED_NAME=Qwen/Qwen3-Reranker-0.6B
RERANK_MAX_MODEL_LEN=8192
RERANK_GPU_MEM_UTIL=0.06
# Internal URL the gateway uses to reach the reranker backend.
RERANK_URL=http://vllm-rerank:8000
# Attention backend for the pooling runner — same "auto" sentinel/rationale as
# EMBED_ATTENTION_BACKEND above. Thor (sm_110) sets:
# RERANK_ATTENTION_BACKEND=TRITON_ATTN — same FLASH_ATTN pooling bug as
# vllm-embed, surfacing here as NaN relevance scores instead of a hang. See
# #109/#105.
RERANK_ATTENTION_BACKEND=auto
# Whole CLI token, not a bool — vLLM's `enforce_eager: bool` field gets
# argparse.BooleanOptionalAction, so both --enforce-eager and
# --no-enforce-eager are always-valid tokens (never a conditionally-omitted
# flag). The shipped default --no-enforce-eager is an explicit no-op
# (ModelConfig.enforce_eager already defaults to False, i.e. CUDA graphs on)
# — byte-equivalent effective behavior to today's flagless render. Thor
# (sm_110) sets: RERANK_ENFORCE_EAGER=--enforce-eager — the classify path
# faults under CUDA graphs (cudaErrorLaunchFailure kills the engine
# mid-request). See #109/#106.
RERANK_ENFORCE_EAGER=--no-enforce-eager

# --- Opt-in minor generate backend (4B, bf16) ----------------------------
# Activate with: docker compose --profile minor up -d
# OR add "minor" to COMPOSE_PROFILES in .env.
# When active, set MINOR_BASE_URL so the gateway routes minor-model requests here.
# MINOR_MODEL=Qwen/Qwen3.5-4B
# MINOR_SERVED_NAME=Qwen/Qwen3.5-4B
# MINOR_BASE_URL=http://vllm-minor:8000
# VLLM_MINOR_MAX_MODEL_LEN=32768
# VLLM_MINOR_GPU_MEM_UTIL=0.10

# --- Opt-in middle generate backend (14B NVFP4, legacy candidate) ----------
# LEGACY: the 14B "middle" is no longer the "normal" tier — that role is now
# filled by the default-on vllm-multimodal (Gemma 4 12B) gear. This entry is
# kept for operators who explicitly want the Qwen 14B text-only model.
# Activate with: docker compose --profile middle up -d
# OR add "middle" to COMPOSE_PROFILES in .env.
# When active, set MIDDLE_BASE_URL so the gateway routes middle-model requests here.
MIDDLE_MODEL=nvidia/Qwen3-14B-NVFP4
MIDDLE_SERVED_NAME=nvidia/Qwen3-14B-NVFP4
# MIDDLE_BASE_URL=http://vllm-middle:8000    # uncomment to activate gateway routing
MIDDLE_MAX_MODEL_LEN=32768
MIDDLE_GPU_MEM_UTIL=0.12

# --- Multimodal generate backend (Gemma 4 12B, NVFP4, default-on) ----------
# The fleet's "multimodal" generate gear: Gemma 4 12B unified text+image+audio.
# Always started alongside the primary (no --profile required). Vision + audio
# are active (no --language-model-only). NVFP4. Native MTP speculative decoding
# is ON BY DEFAULT (docs/vllm-nightly-migration.md §7): the NVFP4 BASE it-model
# (coolthor/gemma-4-12B-it-NVFP4A16), not the coder fine-tune — measured 28.6
# tok/s at 57.9% draft acceptance, the fastest Gemma config on this hardware. The
# coder fine-tune is KEPT as the opt-in `vllm-multimodal-coder` service below
# (coding-strong, but its MTP acceptance is only 30.8% — not worth defaulting).
# GPU budget: util 0.14 (~18 GiB, 32K context) alongside the 27B primary (util
# 0.30, 128K context, ~38 GiB) — util 0.14 is PROVISIONAL, to be validated live
# on the GB10 (plan task t12); see docs/vllm-nightly-migration.md §8.
# TODO(risk r5): measure real multimodal util (vision+audio KV) on the Spark in t7.
#
# MULTIMODAL_IMAGE — controls the OCI image for the vllm-multimodal service.
# Gemma 4's gemma4_unified arch needs vLLM's native Gemma4UnifiedForConditionalGeneration
# class (only in vLLM nightly >= 0.23.1rc1), so vllm-multimodal uses a custom
# Dockerfile (Dockerfile.vllm-gemma4) built FROM the official vllm/vllm-openai
# nightly image (pinned by digest) + the vllm[audio] extra.  Two usage modes:
#
#   Unset (default local build):
#     `lobes fleet up --apply` runs `docker compose up -d --build`, which builds
#     Dockerfile.vllm-gemma4 and tags the result as lobes/vllm-gemma4:local.
#     No value needed here — the build: block in docker-compose.yml handles it.
#
#   Set to a registry tag (pre-built image):
#     MULTIMODAL_IMAGE=ghcr.io/agentculture/vllm-gemma4:latest
#     Then pull it and run WITHOUT --build (a --build would rebuild the local
#     Dockerfile and shadow the pulled tag):
#       docker compose pull vllm-multimodal
#       docker compose up -d vllm-multimodal   # no --build; uses the pulled tag
#     `lobes fleet up` forces --build, so use plain docker compose for a registry
#     tag (or a future `lobes fleet up --no-build`).
#     A local registry tag (e.g. lobes/vllm-gemma4:custom) works the same way.
#
# MULTIMODAL_IMAGE=ghcr.io/agentculture/vllm-gemma4:latest   # example registry tag
# --- `hand` lobe (the ninth Colleague role, DEFAULT-ON) --------------------
# LiquidAI LFM2.5-1.2B-Instruct — the fleet's designated FINE-TUNING BASE.
# "Muscle memory": one cheap base, many LoRA adapters, each mastering a domain.
# See docs/lfm2.5-1.2b-hand.md.
#
# Uncommented (not opt-in) like the multimodal gear below: at ~2.4 GiB bf16 it
# co-resides on every supported card, which is the whole reason the role exists.
# It is ALSO what `model=minor` / `model=cheap` resolve to (it replaced
# Qwen/Qwen3.5-4B in that tier) and the pressure-policy SERVABLE FLOOR — the one
# generate lane never shed under load.
HAND_MODEL=LiquidAI/LFM2.5-1.2B-Instruct
HAND_SERVED_NAME=LiquidAI/LFM2.5-1.2B-Instruct
HAND_BASE_URL=http://vllm-hand:8000
# 32K native. DECLARED, not measured (#108) — see the per-card [roles.hand]
# blocks in lobes/profiles/builtin/*.toml, which is where the real per-card
# values live (0.06 on the 128 GB Spark/Thor, 0.10 on the 64 GB Orin, because
# 0.06 of 64 GB leaves too little KV after the weights).
HAND_MAX_MODEL_LEN=32768
HAND_GPU_MEM_UTIL=0.06
# The nightly over-estimates cudagraph memory for this lane too. MEASURED on a
# physical Jetson AGX Orin 2026-08-10: with the estimate ON, hand profiles to
# **Available KV cache memory: -9.25 GiB** at util 0.10 — negative, so the boot
# dies with no KV cache at all. Disabling it maps the util knob back to true
# usage, exactly as the primary/multimodal/muse/worker lanes already do. Set to
# 1 to re-enable (and then expect to need ~4.6x the util for the same KV).
HAND_CUDAGRAPH_ESTIMATE=0
# Attention backend, consumed via --attention-config (VLLM_ATTENTION_BACKEND is
# gone on this nightly). "auto" is byte-equivalent to omitting the flag. The
# orin card profile declares TRITON_ATTN here; the 128 GB cards stay on auto.
HAND_ATTENTION_BACKEND=auto
# bf16 — there is deliberately NO HAND_QUANTIZATION knob. The catalog's
# quantization="none" sentinel means the lane omits --quantization ENTIRELY;
# passing modelopt to a bf16 checkpoint corrupts the weights.
#
# --- LoRA adapters (the muscle-memory surface) -----------------------------
# Comma-separated `name=path`, read by BOTH the engine (vllm-hand's
# --lora-modules) and the gateway (which derives the caller-facing
# `hand:<domain>` aliases from it), so the two can never disagree about which
# adapters exist. Paths are IN-CONTAINER, under the /adapters mount (see
# HAND_ADAPTER_DIR) — not host paths.
#
# EMPTY by default: v1 ships the lane ARMED (--enable-lora) with ZERO adapters.
# An armed-but-empty lane is honest; a promised-later one is not. There is NO
# runtime hot-load — adding an adapter is a lane restart.
#
# Addressing: `model=hand` serves the BASE (it never 404s just because the
# inventory is empty); `model=hand:<domain>` serves that adapter; an undeclared
# `hand:<domain>` is refused with model_not_found, never silently downgraded to
# the base. An adapter vLLM could not load is absent from /v1/models AND
# /capabilities — declared is not the same as usable (#92).
# HAND_LORA_MODULES=legal=/adapters/legal,sql=/adapters/sql
HAND_LORA_MODULES=
# HAND_ADAPTER_DIR=./adapters   # host dir bind-mounted read-only at /adapters
# HAND_MAX_LORAS=4              # concurrently-resident adapters
# HAND_MAX_LORA_RANK=32         # rank ceiling; a higher-rank adapter FAILS to
#                               # load (and is then simply not advertised).
#                               # Raise and restart the lane to serve it.
# HAND_IMAGE=   # override the OCI image; unset falls back to VLLM_NIGHTLY_IMAGE.
#               # Lfm2ForCausalLM needs vLLM >= 0.23.0, so this lane must NOT
#               # use the NGC 26.04 tag vllm-minor rides (that engine is 0.19.0).
# hand rides the same feasibility channel as every other role since
# 2026-08-20 (a recorded REVERSAL of the original never-proxied decision —
# see NEVER_PROXIED_BACKENDS in lobes/gateway/_config.py): "small enough to
# fit everywhere" did not survive contact with a card whose kernels serve
# LFM2.5 incorrectly (Thor sm_110,
# docs/evidence/2026-08-20-hand-thor-blocked-reattributed.txt). A box that
# cannot serve hand declares it off:
# HAND_FEASIBLE=false           # this box never serves hand (per-card fact)
# The retired *_PEER_ORIGIN/*_PEER_PROXY/*_PEER_API_KEY referral/proxy knobs
# this reversal used to ride are gone (t14) — declare the mesh instead.
# Caveat that survives the reversal: a `hand:<domain>` adapter resolves only
# on a peer that actually loaded that adapter — referral does not teleport
# adapter files.

MULTIMODAL_MODEL=coolthor/gemma-4-12B-it-NVFP4A16
MULTIMODAL_SERVED_NAME=coolthor/gemma-4-12B-it-NVFP4A16
MULTIMODAL_BASE_URL=http://vllm-multimodal:8000
# Trimmed to 32K (from 128K) to free KV headroom for the 27B primary to serve
# its full 128K native context — the always-on duo's context rebalance. Superseded
# the earlier 131072/util-0.22 pairing (#71). See docs/vllm-nightly-migration.md §8.
MULTIMODAL_MAX_MODEL_LEN=32768
# LIVE-VALIDATED on the GB10 2026-07-03 (#81 t12): senses@32K at util 0.14 =
# 8.87 GiB available KV (184,084 tokens) = 5.62x concurrency — healthy, with margin.
# DO NOT go lower: Gemma-12B weights+CUDA-graph are ~13.4 GiB (~util 0.105 floor),
# so 0.10 would OOM before any KV cache.
MULTIMODAL_GPU_MEM_UTIL=0.14
# vLLM 0.23 over-estimates cudagraph memory for this gear (12.74 GiB estimated vs
# 0.46 GiB actual, #71), starving the KV cache so a naive util fails with "No
# available memory for the cache blocks". Disabling the estimate maps the util
# knob back to true usage (~18 GiB actual ≈ 0.14 of the 128 GB GB10, §8). Set to
# 1 to re-enable.
MULTIMODAL_CUDAGRAPH_ESTIMATE=0
# compressed-tensors (nvfp4-pack-quantized) — the checkpoint's own quant_method.
# NOT modelopt_fp4 (that fails with a quant-method mismatch). Verified live (#71).
MULTIMODAL_QUANTIZATION=compressed-tensors
# Attention backend. Gemma 4 interleaves sliding (head 256) and full-attention
# (head 512) layers; TRITON_ATTN handles the heterogeneous sizes. The native
# gemma4_unified class auto-forces it; set explicitly too (matches the vLLM recipe).
MULTIMODAL_ATTENTION_BACKEND=TRITON_ATTN
# MULTIMODAL_SPECULATIVE_CONFIG — the senses lane's MTP off-switch. LEAVE IT UNSET
# (commented out, as it is here) for the shipped behaviour: native MTP speculative
# decoding against the public google/gemma-4-12B-it-assistant draft — 57.9% draft
# acceptance, ~1.45x decode (docs/vllm-nightly-migration.md §7). The default lives
# in the vllm-multimodal command in docker-compose.yml and matches
# lobes.catalog.SUPPORTED_MODELS' coolthor entry byte for byte.
#
# Setting it to the EMPTY string drops speculative decoding entirely — the flag is
# omitted from the vLLM argv, not blanked:
#
#   MULTIMODAL_SPECULATIVE_CONFIG=
#
# That is the recorded fallback for serving a checkpoint with no MTP draft head
# (e.g. unsloth/gemma-4-12B-it-qat-w4a16): attempt the draft, and if vLLM refuses
# it, drop spec-decode rather than block the swap. Mind the difference between
# unset and empty — this knob alone uses compose's dash-only default operator
# precisely so an empty value means "off" instead of "use the default".
#
# To RETARGET the draft rather than disable it, BOTH quoting layers matter (the
# value crosses compose's dotenv parser first, then its shell-lexer). This form
# works; bare single quotes silently mangle the JSON into two argv tokens:
#
#   MULTIMODAL_SPECULATIVE_CONFIG="'--speculative-config={\"method\": \"ngram\", \"num_speculative_tokens\": 2}'"
#
# The DeepSeek DSpark draft (deepseek-ai/dspark_gemma4_12b_block7) was investigated
# and found INVALID on vLLM 0.23 — its custom Gemma4DSparkModel architecture is not
# in the supported speculative-draft set (§6) — do not wire it.

# --- Opt-in coder generate backend (Gemma 4 12B coder fine-tune) -----------
# KEPT (cite-don't-delete), DEMOTED from the default "multimodal" gear (§7):
# coding-strong, but native MTP only reaches 30.8% draft acceptance on this
# fine-tune (a marginal ~6% decode win) — not worth wiring/defaulting.
# Activate with: docker compose --profile multimodal-coder up -d
# OR add "multimodal-coder" to COMPOSE_PROFILES in .env.
# When active, set MULTIMODAL_CODER_BASE_URL so the gateway routes the
# "multimodal-coder" alias (and the coder's served id) here.
MULTIMODAL_CODER_MODEL=sakamakismile/gemma-4-12B-coder-fable5-composer2.5-MTP-NVFP4
MULTIMODAL_CODER_SERVED_NAME=sakamakismile/gemma-4-12B-coder-fable5-composer2.5-MTP-NVFP4
# MULTIMODAL_CODER_BASE_URL=http://vllm-multimodal-coder:8000    # uncomment to activate gateway routing
MULTIMODAL_CODER_MAX_MODEL_LEN=8192
MULTIMODAL_CODER_GPU_MEM_UTIL=0.12
MULTIMODAL_CODER_QUANTIZATION=compressed-tensors
MULTIMODAL_CODER_ATTENTION_BACKEND=TRITON_ATTN
MULTIMODAL_CODER_CUDAGRAPH_ESTIMATE=0
# No speculative decoding: native MTP measured only 30.8% draft acceptance on this
# coder fine-tune (§6/§7) — not worth wiring.

# --- Opt-in muse generate backend (Gemma 4 31B IT, NVIDIA NVFP4) ------------
# The SEVENTH Colleague role: the creative/ideation lobe (`muse`). An opt-in
# HEAVY lobe — 30.4 GiB of weights — that machine-as-brain never hosts: it only
# runs on a muse-hosting deployment shape that drops BOTH heavy default lobes
# first (`lobes init --shape thor-muse --apply`). The shape render writes the
# activation pair into .env for you:
#   COMPOSE_PROFILES=muse           # un-gates the profile-gated vllm-muse service
#   MUSE_BASE_URL=http://vllm-muse:8000   # wires the gateway backend
# plus the MUSE_* knobs from the shape's own overrides. Values below mirror the
# thor-muse shape's DECLARED HYPOTHESIS (the acceptance run measures the real
# budget — see lobes/profiles/builtin_shapes/thor-muse.toml). Same custom image
# as vllm-multimodal (Dockerfile.vllm-gemma4); MUSE_IMAGE overrides the tag the
# same way MULTIMODAL_IMAGE does.
# MUSE_MODEL=nvidia/Gemma-4-31B-IT-NVFP4
# MUSE_SERVED_NAME=nvidia/Gemma-4-31B-IT-NVFP4
# MUSE_BASE_URL=http://vllm-muse:8000    # set by a muse-hosting shape render
# MUSE_MAX_MODEL_LEN=262144      # the FULL 256K native window (no trim)
# MUSE_GPU_MEM_UTIL=0.55         # measured 2026-07-17 (Thor): 26.47 GiB KV, 2.33x @ 262144
# MUSE_QUANTIZATION=modelopt     # NVIDIA export (quant_method=modelopt), NOT compressed-tensors
# MUSE_ATTENTION_BACKEND=TRITON_ATTN
# MUSE_CUDAGRAPH_ESTIMATE=0
# Native MTP via google/gemma-4-31B-it-assistant is baked into the vllm-muse
# command in docker-compose.yml (a literal --speculative-config flag, matching
# lobes.catalog's nvidia/Gemma-4-31B-IT-NVFP4 entry). DECLARED, unmeasured on
# this target — remove the line from the compose command by hand to disable.

# --- Opt-in worker generate backend (Qwen3.6-35B-A3B, NVFP4 MoE) ------------
# The EIGHTH Colleague role: the fast ground-work DOER (`worker`) — an opt-in
# CORE, MULTIMODAL heavy lobe (image+video intake, NO audio). Like `muse`,
# machine-as-brain never hosts it: it runs ONLY on a worker-hosting deployment
# shape that drops the heavy default lobes first
# (`lobes init --shape thor-worker --apply`). The shape render writes the
# activation pair into .env for you:
#   COMPOSE_PROFILES=worker         # un-gates the profile-gated vllm-worker service
#   WORKER_BASE_URL=http://vllm-worker:8000   # wires the gateway backend
# plus the WORKER_* budget knobs from the shape's own overrides. Every value
# below is a DECLARED placeholder — the real GPU budget / MoE backend is
# MEASURED on Thor at t7 (the live boot), exactly as thor-muse's 0.55 was
# measured, not computed. UNCONFIRMED on Thor sm_110 until then (#108).
#
# Served MULTIMODAL: the compose command deliberately omits --language-model-only
# so worker keeps its ViT vision tower (image+video). Rides the SAME Qwen/vLLM
# nightly lane (VLLM_NIGHTLY_IMAGE) as the primary/embed/rerank gears — it is a
# a NemotronH hybrid, NOT a Gemma gear, so it does NOT use lobes/vllm-gemma4:local.
# Default checkpoint since 2026-08-20 (d1): the catalog's role_hint=worker
# model nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4 — VALIDATED live on
# a DGX Spark GB10 (75.1 tok/s, docs/evidence/2026-08-20-accept-worker-hand-spark.txt)
# and a NO-GO on Jetson Thor sm_110 (Mamba-2 SSD warmup wedge,
# docs/evidence/2026-08-20-spike-lightning-thor-no-go.txt) — host it on a card
# whose kernels serve nemotron_h. To serve the demoted Qwen candidate instead,
# set the four commented values marked "Qwen candidate" below together.
# WORKER_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
# WORKER_SERVED_NAME=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
# WORKER_BASE_URL=http://vllm-worker:8000    # set by a worker-hosting shape render
# WORKER_MAX_MODEL_LEN=65536     # the Spark-VALIDATED window; ceiling is 1M — grow with evidence (#187)
# WORKER_GPU_MEM_UTIL=0.30       # validated on the Spark 2026-08-20 (weights 17.85 GiB, KV 3.56M tokens)
# WORKER_QUANTIZATION=modelopt   # Lightning's OWN quant_method (config.json). Qwen candidate: compressed-tensors
# WORKER_IMAGE=   # override the OCI image; unset falls back to VLLM_NIGHTLY_IMAGE (the fleet-wide Qwen nightly pin)
#
# --- the worker lane's RECIPE KNOBS (worker-recipe-knobs t3) ----------------
# Every knob below is DEFAULT-ABSENT: with none of them set the vllm-worker
# argv is byte-identical to what the lane rendered before they existed, and
# vLLM's own defaults apply. They exist so an arm that needs one is a .env
# line (or a profile/shape declaration — the same names appear as knobs in
# lobes/profiles/schema.py) instead of a hand-edit of this deployment's
# docker-compose.yml, which is precisely the drift deployment.lock.toml exists
# to catch. NONE of these values is measured on a worker box (#108): the lane
# can now EXPRESS them, which is not a recommendation to set them.
#
# Value-carrying knobs use compose's ${VAR:+…} form — unset OR empty renders
# no argv token at all (an EMPTY token is fatal: `vllm serve` reads it as a
# second positional and exits 2):
#
# WORKER_KV_CACHE_DTYPE=fp8        # --kv-cache-dtype; unset = vLLM's own auto
# WORKER_ATTENTION_BACKEND=TRITON_ATTN
#   Rendered as the --attention-config JSON flag (NOT the dead
#   VLLM_ATTENTION_BACKEND env), the same surface vllm-embed / vllm-rerank /
#   vllm-hand use. Unset renders no flag, so vLLM auto-selects exactly as it
#   did before this knob was wired. It USED to be documented here as
#   "deliberately NOT wired" — worker rides the Qwen generate lane and needed
#   no override on Thor (cortex's only sm_110 divergence is kv_cache_dtype).
#   That is still the DEFAULT; it is no longer a template edit to change.
# WORKER_MOE_BACKEND=triton        # --moe-backend; see the note below
# WORKER_LOAD_FORMAT=runai_streamer  # --load-format (weight loading path)
# WORKER_MAX_NUM_SEQS=8            # --max-num-seqs (concurrent sequences)
# WORKER_MAX_NUM_BATCHED_TOKENS=16384  # --max-num-batched-tokens (step budget)
#
# WORKER_MOE_BACKEND is unset for a MEASURED reason, not an arbitrary one: on
# Thor sm_110 (2026-07-31, docs/evidence/2026-07-31-accept-worker-thor.txt)
# every forced backend was REFUSED, while auto-select booted — vLLM picks
# TRITON for the unquantized/fp8 MoE plus a modular NVFP4 kernel for the main
# experts, and the fastest supported kernel on a Spark. Pin one only where you
# have measured it.
#
# Boolean toggles hold the FULL flag text (the RERANK_ENFORCE_EAGER /
# ASSOCIATE_PREFIX_CACHING idiom) so the operator picks the polarity; the
# compose slot is the dash-only ${VAR-}, so unset or empty means "no flag":
#
# WORKER_CHUNKED_PREFILL=--enable-chunked-prefill      # or --no-enable-chunked-prefill
# WORKER_ASYNC_SCHEDULING=--async-scheduling           # or --no-async-scheduling
# WORKER_PREFIX_CACHING=--enable-prefix-caching        # or --no-enable-prefix-caching
#
# WORKER_TOOL_CALL_PARSER — the lane's --tool-call-parser, default qwen3_coder
# (BOTH worker checkpoints agree on it; validated live on the Spark
# 2026-08-20 alongside nemotron_v3 reasoning). It was HARDCODED until t3.
# Select another parser the served build registers — e.g. qwen3_xml — when the
# checkpoint emits a different call shape. The gateway ALSO reads this key for
# the capabilities `tool_parser` field and the replica-pool fingerprint, so
# setting it keeps the advert and the lane in agreement.
# WORKER_TOOL_CALL_PARSER=qwen3_coder
#
# WORKER_SPECULATIVE_CONFIG — the worker lane's MTP off-switch (the same
# mechanism as MULTIMODAL_SPECULATIVE_CONFIG above, also wired onto
# vllm-primary as PRIMARY_SPECULATIVE_CONFIG). DEFAULT-OFF since 2026-08-20:
# the default Lightning worker serves PLAIN decode (its MTP/DSpark benefit is
# card-declared but unmeasured on this fleet; the Spark validation ran without
# it, per #187's measure-plain-first rule —
# docs/evidence/2026-08-20-accept-worker-hand-spark.txt).
#
# To ENABLE speculative decoding once measured (or when serving the demoted
# Qwen candidate, whose self-draft MTP was validated on Thor 2026-07-31):
#
#   WORKER_SPECULATIVE_CONFIG="'--speculative-config={\"method\": \"mtp\", \"num_speculative_tokens\": 2}'"
#
# This knob uses compose's dash-only default operator (`${VAR-default}`, not
# `${VAR:-default}`), so set-but-empty also reads as "off"; see
# MULTIMODAL_SPECULATIVE_CONFIG above for the dotenv/shell-lexer quoting
# caveat on JSON-bearing values.
#
# WORKER_REASONING_PARSER — the worker lane's --reasoning-parser knob. Default
# is nemotron_v3, matching the CURRENT catalog role_hint=worker model
# (nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4): structured tool_calls
# validated live on the Spark 2026-08-20 through the nemotron_v3 (reasoning) +
# qwen3_coder (tool-call, hardcoded below — both worker checkpoints agree on
# it) parser pair — see
# docs/evidence/2026-08-20-accept-worker-hand-spark.txt. The compose default
# WORKER_MODEL is that same Lightning checkpoint, so the defaults are
# internally consistent out of the box. Qwen candidate
# (unsloth/Qwen3.6-35B-A3B-NVFP4): override WORKER_REASONING_PARSER=qwen3 —
# nemotron_v3 is the wrong grammar for that checkpoint's thinking traces —
# together with WORKER_QUANTIZATION=compressed-tensors, the 262144 window, and
# the Thor-validated MTP value in WORKER_SPECULATIVE_CONFIG's comment above.
# WORKER_REASONING_PARSER=nemotron_v3

# --- Opt-in associate generate backend (Nemotron 3.5 Lightning) -------------
# lightning-on-orin plan, t7 (the lane) + t6 (the role). This lane gives
# NVIDIA's published Jetson serve recipe's EIGHT previously-unexpressible flags
# a real home (docs/plans/2026-08-25-lightning-on-orin.md).
#
# `associate` is the TENTH Colleague role: `worker` MINUS `repo_action` — it
# executes, drafts, inspects and calls tools, and hands the result BACK rather
# than enacting it. It is OPT-IN-hosted exactly like muse/worker: the gateway
# wires its backend only when ASSOCIATE_BASE_URL is set, and an UNWIRED
# associate is INFEASIBLE by default, so `model=associate` 404s
# role_infeasible (referable/proxyable via the peer knobs below) instead of
# silently falling back to cortex. Setting COMPOSE_PROFILES=associate starts
# the vllm-associate container; ASSOCIATE_BASE_URL is what makes the gateway
# route to it.
#
# SET GATEWAY_API_KEY IF YOU HOST THIS LANE (lightning-on-orin t10). The
# vllm-associate container publishes no host port, so the gateway is its only
# front door — and the gateway's bearer gate is OPT-IN, so a hosted associate
# with no inbound key is an uncredentialed 30B generate lane on your tailnet.
# That is not hypothetical: running NVIDIA's recipe verbatim on 2026-08-25 put
# one up, and two distinct tailnet peers queried it unprompted within seconds
# (docs/evidence/2026-08-26-associate-gateway-auth-front.txt). `lobes doctor`
# fails an associate-hosting deployment that sets neither GATEWAY_API_KEY nor
# CULTURE_VLLM_API_KEY (see the "Inbound gateway auth" section below).
#
# ASSOCIATE_BASE_URL=http://vllm-associate:8000   # wires the gateway backend (an associate-hosting shape renders this)
# ASSOCIATE_FEASIBLE=                             # explicit false vetoes the lane on this box; absent + unwired = infeasible (opt-in default)
# The retired *_PEER_ORIGIN(S)/*_PEER_PROXY/*_PEER_API_KEY(S) referral/proxy/
# replica-pool knobs this box used to declare associate through are gone
# (t14) — declare the mesh instead.
#
# ASSOCIATE_IMAGE=   # override the OCI image; unset falls back to VLLM_NIGHTLY_IMAGE (the fleet-wide nightly pin)
# ASSOCIATE_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
# ASSOCIATE_SERVED_NAME=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
# ASSOCIATE_QUANTIZATION=modelopt        # Lightning's own quant_method
# ASSOCIATE_KV_CACHE_DTYPE=bfloat16      # already-expressible mechanism, same shape as PRIMARY_KV_CACHE_DTYPE
# ASSOCIATE_MAX_MODEL_LEN=65536          # PLACEHOLDER — the real budget is MEASURED on the Orin at t8, not this lane
# ASSOCIATE_GPU_MEM_UTIL=0.30            # PLACEHOLDER — see t8; the recipe's own 0.7 was refused as a naive copy-forward (see spec c35)
# ASSOCIATE_SPECULATIVE_CONFIG=          # same dash-only off-switch idiom as WORKER_SPECULATIVE_CONFIG (unset = no --speculative-config token)
# ASSOCIATE_REASONING_PARSER=nemotron_v3
#
# The eight flags this lane exists for — all from the vendor's published Jetson
# recipe (docs/specs/2026-08-25-lightning-on-orin.md), each now a real
# ``vllm serve`` flag on this lane:
# ASSOCIATE_MAMBA_BACKEND=flashinfer                                    # governs the SSU kernel, NOT the SSD Triton warmup (measured live on the Orin 2026-08-25 — see docs/evidence/2026-08-25-spike-lightning-vllm-orin.txt)
# ASSOCIATE_MAMBA_SSM_CACHE_DTYPE=float16
# ASSOCIATE_MAMBA_CACHE_STOCHASTIC_ROUNDING=--enable-mamba-cache-stochastic-rounding   # full flag text (like RERANK_ENFORCE_EAGER above); set to --no-enable-mamba-cache-stochastic-rounding to disable
# ASSOCIATE_MAMBA_CACHE_PHILOX_ROUNDS=5
# ASSOCIATE_MAMBA_CACHE_MODE=align
# ASSOCIATE_PREFIX_CACHING=--enable-prefix-caching       # full flag text; set to --no-enable-prefix-caching to disable
# ASSOCIATE_MAX_NUM_BATCHED_TOKENS=16384
#
# Not one of the eight, added by orin-associate-1m t1 (same idiom as
# WORKER_MAX_NUM_SEQS): unset renders no --max-num-seqs token at all; a
# 1M-token window leaves little KV headroom per sequence, so this is how an
# operator caps concurrency to afford the depth.
# ASSOCIATE_MAX_NUM_SEQS=2         # --max-num-seqs (concurrent sequences)
#
# Mirrors PRIMARY_ALLOW_LONG_MAX_MODEL_LEN: OFF by default; only a shape
# serving ASSOCIATE_MAX_MODEL_LEN beyond the checkpoint's own declared
# ceiling (the orin-associate-1m 1,048,576-token hypothesis) needs this set.
# ASSOCIATE_ALLOW_LONG_MAX_MODEL_LEN=1
#
# --trust-remote-code is HARDCODED on this lane (not a knob) — every other
# generate lane in docker-compose.yml hardcodes it the same way; it is a
# fixed security posture, not a per-deployment tuning choice.

# --- Opt-in llama.cpp cortex lane (GGUF, the fleet's first non-vLLM engine) --
# `cortex` served by `llama-server` instead of vLLM, from a GGUF checkpoint
# (unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_M — see lobes/catalog.py's `engine` axis and
# docs/qwen3.8-27b-gguf-llamacpp.md). It exists for a card that cannot run the
# NVFP4 primary AT ALL: NVFP4 quantizes activations to FP4 (W4A4) and needs
# Blackwell tensor cores, while a GGUF Q4_K_M is weight-only and decodes on the
# Jetson AGX Orin's Ampere sm_87.
#
# Parked behind the `llamacpp` Docker Compose profile, so no existing deployment
# starts it. A shape whose composed `cortex` model is a llama.cpp catalog gear
# (today: `lobes init --shape orin-cortex`) writes the activation pair into .env
# for you, and the generated docker-compose.shape.yml parks `vllm-primary` in the
# same render so the two cortex lanes never run together:
#   COMPOSE_PROFILES=llamacpp                    # un-gates the llamacpp-primary service
#   PRIMARY_URL=http://llamacpp-primary:8000     # points the gateway at this lane
# plus PRIMARY_MODEL / PRIMARY_SERVED_NAME / PRIMARY_MAX_MODEL_LEN from the card
# profile. The role alias callers use (`model=cortex|main|hard`) does not move.
#
# THE GGUF IS NOT DOWNLOADED BY THIS LANE. Place the file yourself and point
# LLAMACPP_MODEL_DIR at its directory; it is mounted read-only at /models.
#   hf download unsloth/Qwen3.8-27B-GGUF Qwen3.8-27B-UD-Q4_K_M.gguf --local-dir <dir>
# LLAMACPP_MODEL_DIR=~/.cache/llama.cpp   # host dir holding the .gguf (mounted /models:ro)
# LLAMACPP_GGUF=Qwen3.8-27B-UD-Q4_K_M.gguf   # the file INSIDE that dir; 15.33 GiB
# LLAMACPP_IMAGE=   # override the pinned digest; see docker-compose.yml for the
#                   # measured benchmark that chose it and the recorded runner-up
# LLAMACPP_N_GPU_LAYERS=99   # -ngl: offload every layer; confirm in the boot log
# LLAMACPP_PARALLEL=1        # -np: server slots. llama.cpp SPLITS -c across slots,
#                            # so raising this divides the served context
# LLAMACPP_FLASH_ATTN=on     # -fa: measured faster than off on the Orin (2026-08-23)
#
# MEMORY, MEASURED on the Orin 64GB at the full 262144 window (2026-08-23):
# weights 15.33 GiB + KV 16.00 GiB = ~33 GiB resident. KV costs 64 KiB/token
# because only 16 of the 65 layers hold a per-token cache (the other 49 are
# Mamba/SSM with constant state). Load time 84 s cold / 15.6 s warm-cache.
# There is NO gpu_mem_util knob on this engine — memory follows -ngl and -c, so
# trim PRIMARY_MAX_MODEL_LEN to shrink the footprint.
#
# WHAT THIS LANE DOES NOT HAVE (versus the vLLM cortex): no MTP speculative
# decoding (llama.cpp ignores the checkpoint's MTP head — ~0.9 GiB of the file is
# dead weight here), no ViT (this GGUF is text-only), and no --quantization /
# --tool-call-parser / --reasoning-parser flags at all (Q4_K_M lives inside the
# .gguf; --jinja plus the model's own chat template supplies tool calls and
# reasoning_content). See docs/qwen3.8-27b-gguf-llamacpp.md.

# GPU-mem-util co-residency budget — the "always-on duo" defaults. The cortex/senses
# (128K/32K) rebalance was live-validated co-resident on the GB10 2026-07-03 (#81 t12):
# cortex@128K/0.30 = 3.58x concurrency (18.02 GiB KV), senses@32K/0.14 = 5.62x (8.87 GiB
# KV), both healthy. (Raise carefully — vLLM fills its util budget with KV cache
# regardless of --max-model-len, so weights + KV must both fit.)
#   Default fleet: cortex 0.30 (128K) + senses 0.14 (32K) + embed 0.06 +
#     rerank 0.06 = 0.56. cortex serves its full 128K context; the always-on Gemma
#     senses gear is trimmed to 32K to free the KV headroom.
#   With opt-in minor (4B):
#     primary 0.30 + multimodal 0.14 + minor 0.10 + embed 0.06 + rerank 0.06 = 0.66
#   With opt-in middle (14B legacy): add 0.12 to any of the above.
#   With opt-in multimodal-coder (12B, alongside the default multimodal base gear):
#     add 0.12 to any of the above.
#   With opt-in embed-deep (4B embedding, alongside the always-on 0.6B embed gear):
#     add 0.11 to any of the above — e.g. the default fleet becomes 0.67, and a
#     senses-dropped spark-lobe box (cortex 0.44 + embed 0.06 + rerank 0.06 = 0.56)
#     becomes 0.67. DECLARED, NOT MEASURED (#108) — verify on the box before
#     committing it to a co-residency budget.
# Without multimodal (primary + embed + rerank only):
#   primary 0.30 + embed 0.06 + rerank 0.06 = 0.42  (raise primary toward 0.6+ if desired)

# --- Gateway (single front OpenAI endpoint) -------------------------------
# Host port acp/culture.yaml expects → mapped to the gateway. The primary backend
# is reachable only on the internal compose network (vllm-primary:8000).
VLLM_PORT=8000
# GATEWAY_PUBLIC_URL — OPTIONAL override for a tunnel / Host-rewriting reverse
# proxy ONLY (e.g. a cloudflared tunnel URL like https://foo.example). Set it
# only when clients dial a different origin than the one they connect to.
# Leave it EMPTY (the default) for a normal published host port: the gateway
# then echoes the origin the client actually dialed (its request Host header)
# in GET /capabilities, so the advertised endpoint is reachable as-is. Do NOT
# set it to a localhost/published-port URL — a set value outranks the Host
# header and would advertise loopback to every remote client (issue #92 / #96).
# GATEWAY_PUBLIC_URL=

# --- The secret env family (deployment-lock-per-box t4) -------------------
# Every fleet service that reads .env (below, `env_file:`) also reads a
# second, sibling file: .secrets.env — a gitignored-by-suffix dotfile
# (`*.env`) beside .env in this same deployment dir. It is OPTIONAL
# (compose's `required: false`): a deployment with none behaves
# byte-identically to today. Its purpose is nothing-retyped-by-hand: a
# generated key (scripts/gen-api-key.py writes GATEWAY_API_KEY straight into
# .env or a dotfile with the stdlib `secrets` module, never printing it) or a
# committed-example/locally-filled shape (the .cf-tunnel.env pattern, see
# cf-tunnel.env.example) can both land secret values in .secrets.env instead
# of this file, without an operator ever typing one by hand. lobes itself
# does not read or write .secrets.env — it exists purely as a second
# env_file entry compose already merges in, same as .env.

# --- Inbound gateway auth (OPT-IN; proxy-lobes t1, issues #115/#127) ------
# Pairwise credential model: ONE inbound key per box. Set GATEWAY_API_KEY to
# require callers of THIS gateway to present it as a bearer token; leave it
# unset (the default, together with CULTURE_VLLM_API_KEY below) and auth
# stays disabled — byte-identical to today's no-auth behaviour. A mesh
# member that wants to dial you (see the mesh-brain join section below)
# presents this same value back as its outbound credential.
# GATEWAY_API_KEY=
# CULTURE_VLLM_API_KEY is a fallback source for the same inbound key: if
# GATEWAY_API_KEY is blank, the gateway falls back to this value instead (the
# first non-blank of the two wins). Culture-mesh operators who already
# distribute a CULTURE_VLLM_API_KEY to callers of this endpoint get gateway
# auth for free, with no second secret to mint or redistribute — set only
# GATEWAY_API_KEY, only CULTURE_VLLM_API_KEY, or leave both unset.
# CULTURE_VLLM_API_KEY=

# --- Mesh join (OPT-IN; mesh-brain-join) ----------------------------------
# A home fleet of boxes running lobes-cli forms ONE brain: any machine with
# the join key (or an operator's timed/permanent approval) joins the mesh at
# runtime, announces the roles, models and purpose it serves, and can draw on
# every lobe in the mesh even if it serves nothing itself. A heartbeat keeps
# the membership current, so two boxes serving the same role share one
# concurrency pool out of the box. The join key REPLACES the hand-typed
# *_PEER_* family below (now RETIRED as the documented contract — see that
# section's banner): membership is learned by announce/detect, never typed
# per pair. Implementation status: the code-level removal of the retired
# family is done (t14) — the gateway no longer parses any of it, and the
# replica-pool dispatch path reads the mesh roster as its candidate source
# instead. Every mesh behavior here is DECLARED/UNVALIDATED (#108) until a
# live cutover transcript lands under docs/evidence/.
#
# LOBES_MESH_KEY is the fleet's SECRET — one shared join key. Set it (plus
# LOBES_MESH_NAME) to turn the mesh ON for this box; leave it unset (the
# default) and the mesh stays OFF — no heartbeat thread, every /mesh/* route
# 404s, and every response is byte-identical to the pre-mesh contract. Mint
# it once per fleet (scripts/gen-api-key.py, or any 256-bit random string)
# and NEVER commit it: the CI secrets scan (scripts/scan_deployment_secrets.py)
# flags LOBES_MESH_KEY=<value> in every committed deployment artifact, and no
# lock or deployments/ catalog entry may ever carry it. Rotating the key is a
# fleet-wide restart (see docs/secret-rotation.md).
#
# MUST live in THIS file (.env), not .secrets.env (review #252 finding 7):
# the `gateway` service deliberately has no `env_file` — it reads only the
# scoped, non-secret keys Compose interpolates from .env (see the comment on
# the `gateway` service in docker-compose.yml) — so a key placed only in
# .secrets.env never reaches the container; build_mesh_config() then selects
# its disabled configuration with no error at all (`lobes doctor`'s
# `mesh_key_secrets_env_only` finding catches this).
# LOBES_MESH_KEY=
#
# LOBES_MESH_NAME — this box's own short name. OPERATOR-TYPED and REQUIRED
# whenever the key is set (a key with no name is a startup error naming the
# missing key — the name is never derived from the hostname, the
# variation-catalog rule). It is the '{role}-{machine-name}' suffix source
# for lanes that diverge from a peer's fingerprint, and the approval
# ledger's key. Keep it short: it lands in served model names.
# LOBES_MESH_NAME=
#
# LOBES_MESH_SEEDS — bootstrap addresses for a JOINING box only: the
# comma-separated origins of at least one box already in the mesh (the same
# operator-declared origin grammar as the *_PEER_ORIGIN family — full URLs,
# never derived from hostnames/interfaces). After the first successful
# keyless detect the roster learns every other member, so a box that is
# already a member can leave this unset.
# LOBES_MESH_SEEDS=
#
# LOBES_MESH_HEARTBEAT_S — heartbeat interval in seconds (default 60).
# LOBES_MESH_MISSED_MAX — consecutive missed heartbeats before a member is
# dropped from the roster (default 3). Non-positive values are a startup
# error.
# LOBES_MESH_HEARTBEAT_S=
# LOBES_MESH_MISSED_MAX=
#
# LOBES_MESH_LEDGER_PATH — path where the approval ledger (member name ->
# approved_by, expiry) persists. Default /home/gateway/mesh/ledger.json,
# inside the mounted mesh runtime directory. Unset (the default) and the
# mesh is OFF, so the path is inert. The operator may override with any
# absolute path (it must live under the mounted directory, or be another
# bind mount). The ledger is never captured in deployment.lock.toml and
# never rendered into .env.
# LOBES_MESH_LEDGER_PATH=
#
# LOBES_MESH_DIR — host directory that backs the gateway's /home/gateway/mesh
# mount. Default ./mesh beside the compose file; Docker creates this
# DIRECTORY on first recreate as root-owned (uid 0). The operator must
# `chown 10001 <dir>` (the gateway image runs unprivileged) before
# enabling the mesh. This is a compose-interpolation-only knob: it never
# reaches the container as an env var.
# LOBES_MESH_DIR=

# =====================================================================
# RETIRED (mesh-brain-join): the operator-typed peer family below
# =====================================================================
# Everything from here through the end of "Follow the referral:
# proxy-lobes" is RETIRED as the documented operator contract for
# cross-box reachability — the mesh join above (LOBES_MESH_KEY /
# LOBES_MESH_NAME / LOBES_MESH_SEEDS) replaces it: any mesh member gets
# the same honest-referral + auto-wired-proxy + pooled-replica behavior
# for free, with no per-role origin/proxy/key knob to declare. Do NOT
# declare new *_PEER_ORIGIN / *_PEER_PROXY / *_PEER_API_KEY /
# *_PEER_ORIGINS / *_PEER_API_KEYS values in a new deployment — declare
# the mesh instead. `lobes doctor`'s `peer_family_retired` finding flags
# a deployment that still sets one of these keys.
#
# Kept, not deleted, as documentation of the measured mechanism the mesh
# generalizes — but the code-level removal is done (t14): the gateway no
# longer parses ANY of this family, so a value declared below now does
# nothing. `lobes doctor`'s `peer_family_retired` finding is what catches
# a leftover key like this in a deployed `.env`.
# =====================================================================

# --- Retired: honest referral + replica pool peer family (mesh-brain-join) -
# Cross-box reachability used to be a hand-typed, per-role peer channel
# (*_PEER_ORIGIN for referral, plus the plural *_PEER_ORIGINS/*_PEER_API_KEYS
# replica-pool form, issue #199) declared here. Both are RETIRED, in the code
# as well as the docs (t14) — the mesh join above (LOBES_MESH_KEY/
# LOBES_MESH_NAME/LOBES_MESH_SEEDS) replaces them: any mesh member gets the
# same honest-referral + auto-wired-proxy + pooled-replica behavior for free,
# with no per-role origin/proxy/key knob to declare. build_config no longer
# reads any *_PEER_ORIGIN(S)/*_PEER_PROXY/*_PEER_API_KEY(S) key at all, so
# declaring one here does nothing; `lobes doctor`'s `peer_family_retired`
# finding is what catches a leftover value.

# GATEWAY_SELF_ORIGIN — this box's OWN origin, exactly as a peer would dial
# it back (e.g. http://peer-a.example:8000). OPERATOR-TYPED, never derived
# from hostname/interface (the same #92 rule every other origin knob here
# follows). Used to stamp X-Lobes-Served-By on a locally-answered pooled
# request, so a caller can always tell which replica actually served it.
# Leave it unset (the default) and that header reads 'local' instead —
# byte-identical to a pre-#199 deployment.
# GATEWAY_SELF_ORIGIN=

# --- Capacity-relative pool routing (OPT-IN; issue #199, capacity-relative-
# pool-routing) ------------------------------------------------------------
# <PREFIX>_MAX_ACTIVE declares THIS box's own serving capacity for a role —
# the number `_selection.py` divides active requests by to rank replicas by
# UTILISATION (active/capacity) instead of by a hardcoded weight of 1.0. It
# is published on this box's own `/status` (so a peer's ReplicaCache learns
# it on the probe it already runs — no new endpoint) and used locally to rank
# this box's own replica in every pool it participates in.
#
# ****************************************************************************
# * THIS IS NOT PRIMARY_MAX_NUM_SEQS (above). MAX_NUM_SEQS is vLLM's OOM     *
# * safety cap — a number chosen so MTP speculative decoding does not run    *
# * out of memory at high concurrency/context, and it is declared per-card   *
# * by the profile system, not measured. <PREFIX>_MAX_ACTIVE is a MEASURED   *
# * THROUGHPUT KNEE — the highest concurrency at which aggregate throughput  *
# * still rises meaningfully per added slot AND time-to-first-token stays    *
# * under a declared bound — produced by `lobes calibrate <role> --apply`,   *
# * never hand-typed as a guess. It is also not vLLM's KV-cache-derived      *
# * concurrency ceiling (the "N.NNx concurrency at depth D" figures in the   *
# * evidence transcripts) — that is what physically FITS in the KV pool, not *
# * what is USEFUL to route onto. Conflating any of these three numbers is   *
# * the specific confusion this knob exists to prevent.                     *
# ****************************************************************************
#
# A calibrated number is scoped to exactly the (box, checkpoint, context
# window, speculative config) it was measured on: the gateway pins it to the
# live fingerprint (served id + quantization + max_model_len + runtime) it
# arrived under and discards it — reverting that replica to the neutral
# uncalibrated fallback until recalibrated — the moment `lobes switch` or a
# shape re-render changes that fingerprint. An undeclared <PREFIX>_MAX_ACTIVE
# is NOT an error and never makes a replica unselectable: for RANKING it is
# treated as neutral (the median of whatever calibrated capacities are in the
# same candidate set) rather than as a real one-slot capacity, so an
# uncalibrated box is not systematically starved next to a calibrated peer.
#
# PRIMARY_MAX_ACTIVE=
# MULTIMODAL_MAX_ACTIVE=
# MUSE_MAX_ACTIVE=
# WORKER_MAX_ACTIVE=
# ASSOCIATE_MAX_ACTIVE=
# HAND_MAX_ACTIVE=
# EMBED_MAX_ACTIVE=
# RERANK_MAX_ACTIVE=
# STT_MAX_ACTIVE=
# TTS_MAX_ACTIVE=
#
# GATEWAY_CAPACITY_KILL_SWITCH — a single global rollback for the capacity
# SIGNAL only. Set this truthy and every resolved capacity — this box's own
# AND every probed peer's — is pinned to the 1.0 sentinel fleet-wide: the
# pool stays armed and still forwards exactly as before, only the capacity
# INPUT reverts to today's uniform ranking. This is the narrow rollback for
# ONE wrong figure; it does not disarm pooling itself.
# GATEWAY_CAPACITY_KILL_SWITCH=

# --- Declared lane fingerprint, passed through to the gateway (issue #199) -
# Each lane below already declares its own quantization/kv-cache-dtype/
# reasoning-parser/tool-call-parser/speculative-config (see e.g.
# PRIMARY_QUANTIZATION, PRIMARY_KV_CACHE_DTYPE, PRIMARY_TOOL_CALL_PARSER and
# PRIMARY_SPECULATIVE_CONFIG in the cortex section above, or
# WORKER_REASONING_PARSER in the worker section). The gateway container now
# ALSO reads a copy of each of those five knobs, per role prefix
# (PRIMARY/MULTIMODAL/MUSE/WORKER/HAND/EMBED/RERANK/STT/TTS), read-only, so
# GET /capabilities and the replica pool's compatibility check (t4/t5) can
# report and compare what THIS box's lane actually declares — without this
# passthrough the gateway can only guess from the catalog. Not every
# prefix's lane consumes its own env override for every one of these five
# suffixes today (several hardcode the flag instead — see the compose
# template's own per-service comments for exactly which); the gateway
# passthrough is added for ALL NINE prefixes anyway for uniformity, since an
# unused `${VAR:-}` is harmless. Nothing here needs to be set BY YOU — these
# are documented for completeness; set the underlying per-lane knob (e.g.
# PRIMARY_QUANTIZATION above) and the gateway picks up the same value
# automatically via the shared .env.

# Where a request with a missing/unknown `model` routes. EMPTY (the default)
# means "follow the primary gear's served name" (PRIMARY_SERVED_NAME), so the
# default stays correct when a machine profile swaps the cortex model (e.g. the
# conservative `base` profile serves a 4B — a hardcoded 27B here would route
# no-model requests to a name nothing serves). Set it only to pin a different
# explicit default.
GATEWAY_DEFAULT_MODEL=
# Extra name -> served-name routes, comma-separated (e.g.
# 27b=unsloth/Qwen3.8-27B-NVFP4).
GATEWAY_ALIASES=
# Short connect timeout (failover-relevant) vs long read timeout (a reasoning
# model's first token is slow — too tight would falsely trip failover).
GATEWAY_CONNECT_TIMEOUT=5
GATEWAY_READ_TIMEOUT=600

# GATEWAY_FORCE_STRICT_TOOLS — OPT-IN (t3; unset by default). When set, the
# gateway injects `strict: true` into every function tool on a cortex-lane
# chat request before forwarding it to vllm-primary, so tool-call arguments
# are grammar-constrained against the tool's JSON schema instead of merely
# parsed after the fact. Pairs with the qwen3_coder_thinking tool-parser
# plugin above, but is independent of it (strict schema enforcement vs.
# reasoning-aware parsing solve different problems). If a tool's schema fails
# to compile into a grammar, the gateway retries the SAME request once with
# strict stripped back out rather than failing the call outright.
# GATEWAY_FORCE_STRICT_TOOLS=1

# Pressure policy (issue #68): under host memory pressure the gateway degrades
# `main`-tier requests to `minor`. Tune the trigger thresholds per box (defaults
# match the code). Raise LOBES_IOWAIT_DEGRADED_THRESHOLD to 100 to effectively
# DISABLE iowait-based degradation on boxes where /proc/pressure/io reports a
# phantom high value with an idle disk (e.g. the DGX Spark GB10 — dgx-spark-cli#22);
# the swap guard then remains as the real memory-pressure protection.
LOBES_SWAP_DEGRADED_THRESHOLD=75
LOBES_IOWAIT_DEGRADED_THRESHOLD=50

# Pins the gateway image to this lobes-cli release (lobes init --fleet fills in
# the running version). Required — dev/from-source boxes set a TestPyPI .devN.
MODEL_GEAR_VERSION=

# GATEWAY_PIP_EXTRA_INDEX_URL — OPTIONAL dev lane paired with a .devN
# MODEL_GEAR_VERSION: an extra pip index (e.g. https://test.pypi.org/simple/)
# the gateway image build may resolve that version from, so an unreleased
# branch can be validated live with zero hand-edits. Leave unset on releases.
# GATEWAY_PIP_EXTRA_INDEX_URL=

# Coherence mirrors so the read-only verbs (status / whoami / doctor) — which read
# the single-model VLLM_* keys — stay sensible on a fleet deployment. Keep equal
# to PRIMARY_* (the gateway's default).
VLLM_MODEL=unsloth/Qwen3.8-27B-NVFP4
VLLM_SERVED_NAME=unsloth/Qwen3.8-27B-NVFP4
VLLM_TOOL_CALL_PARSER=qwen3_coder
