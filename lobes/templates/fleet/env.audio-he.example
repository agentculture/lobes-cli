
# === Hebrew realtime overlay (hebrew-realtime plan, issue #151 t8/t10) =====
# Layered on top of env.audio.example (the English audio overlay), which is
# layered on top of the base fleet .env. Consumed by
# docker-compose.audio-he.yml's `realtime`, `stt` and `gateway` services. See
# that file's header comment for the full three-layer compose story
# (docker-compose.yml -> docker-compose.audio.yml -> docker-compose.audio-he.yml).
#
# This file documents ONLY the keys the Hebrew overlay adds or overrides.
# Every other audio key (CHATTERBOX_PORT, PARAKEET_PORT, DEFAULT_VOICE,
# VAD_*, TTS_CONCURRENCY, ...) still comes from env.audio.example, unchanged.

# REALTIME_LANGUAGE: the session-default STT/generate language
# (lobes/realtime/_settings.py Settings.language). "he" is what makes this a
# Hebrew deployment: whenever DEFAULT_SYSTEM_PROMPT (below) is left unset,
# the realtime bridge selects the Hebrew default system prompt instead of
# the English one — short spoken Hebrew sentences, and an instruction to
# DESCRIBE (not recite character-by-character) file paths, identifiers,
# hashes, dates and long numbers that show up in a tool result.
REALTIME_LANGUAGE=he

# TOOL_WAIT_TIMEOUT_MS: deadline (ms) a committed turn's tool-call round trip
# is allowed before it force-fails. Read by _settings.py; a later task wires
# it into the floor's per-stage deadline machinery (mirrors how
# VAD_MAX_TURN_MS landed as a settings-side read before a later task
# consumed it). 120000 (2 minutes) here vs. the English deployment's in-code
# default of 60000 — a Hebrew tool-using turn may itself cross a Hebrew
# STT/TTS hop, so the deadline is more generous. Clamped to >=1000 in
# _settings.py: a non-positive value would force-fail every tool call
# instantly.
TOOL_WAIT_TIMEOUT_MS=120000

# OPENAI_MODEL: the voice-lane generate model. APPROVED DEVIATION d1
# (hebrew-realtime plan, 2026-09-18): the Hebrew voice lane is Gemma 4
# `senses` (alias `multimodal`), hosted LOCALLY — NOT `associate`, which the
# plan's original text named (associate is not what this deployment hosts).
# `multimodal` is also the realtime bridge's own hardcoded voice-lane
# default (lobes/realtime/_conversation.py's DEFAULT_VOICE_MODEL) — this
# line makes that choice explicit for the Hebrew deployment rather than
# relying on the empty-string gateway-default-routing fallback the English
# env.audio.example uses. Set this to a different lane (e.g. `cortex`) only
# to trade the ~1s multimodal latency for full reasoning.
OPENAI_MODEL=multimodal

# PHONIKUD_MODEL_PATH: path to the phonikud Hebrew diacritizer model,
# consumed by lobes/realtime/tts_client.py (hebrew-realtime t9). Leave empty
# to disable vocalization — Chatterbox then speaks undiacritized Hebrew
# text, which is legible but more ambiguous than vocalized text.
PHONIKUD_MODEL_PATH=

# TTS_DEBUG_TEXT: truthy (1/true/yes) logs the vocalized text actually sent
# to TTS (lobes/realtime/_vocalize.py) — useful when tuning Hebrew
# vocalization/gershayim handling. Leave empty/off in normal operation.
TTS_DEBUG_TEXT=

# STT_MODEL: the Whisper checkpoint the Hebrew `stt` sidecar serves
# (docker-compose.audio-he.yml's `stt` service overrides `build.dockerfile`
# to Dockerfile.whisper-stt — a transformers/PyTorch server, not Parakeet/
# NeMo). Read by listen_server_whisper.py's MODEL_NAME, and passed through
# to the `gateway` service too (approved deviation d3, hebrew-realtime plan,
# 2026-09-18) so GET /capabilities can advertise the engine actually served
# for the `stt` role (lobes/roles.py's `_declared_audio_engine`, merged task
# t13) instead of the Parakeet default.
STT_MODEL=ivrit-ai/whisper-large-v3-turbo

# STT_RUNTIME: informational label for GET /capabilities — the serving stack
# behind STT_MODEL. "transformers" for this overlay (fixed; not a knob the
# `stt` container itself reads — it always runs transformers here).
STT_RUNTIME=transformers

# STT_LANGUAGE: the session-default transcription language, read by
# listen_server_whisper.py's resolve_language() when a request's `language`
# form field is absent. "he" for a Hebrew deployment. The per-request form
# field, when the bridge sends one, always wins over this default.
STT_LANGUAGE=he

# STT_MIN_AVG_LOGPROB: confidence gate against Whisper hallucinating plain text
# on non-speech ('תודה רבה'). A transcript whose mean token log-probability is
# below this is returned as empty text. Measured on the DGX Spark 2026-09-18:
# real speech >= -0.12, hallucinations <= -0.58. `off` disables it.
STT_MIN_AVG_LOGPROB=-0.35

# === Hebrew TTS: Chatterbox Multilingual sidecar (hebrew-realtime plan,
# task t11 — approved deviation d5, operator 2026-09-18) ===================
# docker-compose.audio-he.yml's `chatterbox` service overrides
# `build.dockerfile` to Dockerfile.chatterbox-ml (Chatterbox MULTILINGUAL —
# see that Dockerfile's header and lobes/realtime/chatterbox_multilingual_
# server.py's module docstring for the full engine/diacritization/runaway-
# guard story) instead of the English-only Dockerfile.chatterbox.
# CHATTERBOX_HOST/CHATTERBOX_PORT are unchanged from env.audio.example.

# TTS_LANGUAGE: the server-side synthesis language (a Chatterbox
# Multilingual `language_id`, not a per-request field — criterion 2). "he"
# for a Hebrew deployment. Read by chatterbox_multilingual_server.py's
# MlSettings; the server's own in-code default is ALSO "he" (not English),
# so leaving this unset on a Dockerfile.chatterbox-ml build still speaks
# Hebrew rather than silently degrading to the English server's behaviour.
TTS_LANGUAGE=he

# TTS_DIACRITIZE: "auto" (default) lets the sidecar diacritize undiacritized
# Hebrew input itself (phonikud, via PHONIKUD_MODEL_PATH below) and bypasses
# Chatterbox's own internal Hebrew diacritizer (chatterbox.models.tokenizers.
# tokenizer.add_hebrew_diacritics, which the base image cannot use anyway —
# it lazily imports dicta_onnx, not installed by Dockerfile.chatterbox-ml) so
# exactly one authority ever vocalizes a request. Text that already carries
# niqqud (e.g. from the realtime bridge's own t9 vocalize-before-chunking
# hook) is passed straight through, never re-diacritized. "off" disables the
# sidecar's own diacritization entirely (Chatterbox's internal — currently a
# no-op — path stays enabled).
TTS_DIACRITIZE=auto

# TTS_MAX_RETRIES: retries after a runaway synthesis before the sidecar
# truncates instead of shipping invented speech. Measured live: the SAME
# 8-word Hebrew sentence once produced 24.5s of audio with ~35 invented
# words in one sample and 2.92s (correct) in another — "Chatterbox SAMPLING
# INSTABILITY" per docs/evidence/2026-09-hebrew-tts-ab-spark.txt. Default 2
# retries = up to 3 total generate() calls per request.
TTS_MAX_RETRIES=2

# PHONIKUD_MODEL_PATH is documented above (the `realtime` bridge's own copy)
# — the `chatterbox` sidecar reads the SAME env var name, pointed at the
# SAME mounted file, for its own TTS_DIACRITIZE=auto fallback path. The
# phonikud ONNX model file itself (phonikud-1.0.int8.onnx, CC BY 4.0) is NOT
# baked into either image and NOT committed to this repo: place it
# somewhere under the mounted HF-cache directory (${HF_CACHE:-~/.cache/
# huggingface}, which both the `realtime` and `chatterbox` containers mount)
# and point this at that in-container path. Leaving it empty degrades BOTH
# consumers to undiacritized Hebrew (a logged warning, never a hard
# failure) — it is not repeated as a second key here.

# TTS_MODEL / TTS_RUNTIME: passed through to the `gateway` service
# (deviation d3, extended from STT to TTS by this task) so
# `GET /capabilities` can name the engine actually served for the `tts`
# role. TTS_MODEL deliberately keeps the SAME value as the English default
# (ResembleAI/chatterbox) — reading the installed package's
# chatterbox.mtl_tts.REPO_ID (2026-09-18) shows the multilingual checkpoint
# files ship from that SAME HuggingFace repo; TTS_RUNTIME is what actually
# distinguishes this deployment's engine in the advert.
TTS_MODEL=ResembleAI/chatterbox
TTS_RUNTIME=chatterbox-multilingual
