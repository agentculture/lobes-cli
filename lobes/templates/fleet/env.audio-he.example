
# === Hebrew realtime overlay (hebrew-realtime plan, issue #151 t8) =========
# Layered on top of env.audio.example (the English audio overlay), which is
# layered on top of the base fleet .env. Consumed by
# docker-compose.audio-he.yml's `realtime` service. See that file's header
# comment for the full three-layer compose story
# (docker-compose.yml -> docker-compose.audio.yml -> docker-compose.audio-he.yml).
#
# This file documents ONLY the keys the Hebrew overlay adds or overrides for
# the `realtime` service. Every other audio key (CHATTERBOX_PORT,
# PARAKEET_PORT, DEFAULT_VOICE, VAD_*, TTS_CONCURRENCY, ...) still comes from
# env.audio.example, unchanged.

# REALTIME_LANGUAGE: the session-default STT/generate language
# (lobes/realtime/_settings.py Settings.language). "he" is what makes this a
# Hebrew deployment: whenever DEFAULT_SYSTEM_PROMPT (below) is left unset,
# the realtime bridge selects the Hebrew default system prompt instead of
# the English one — short spoken Hebrew sentences, and an instruction to
# DESCRIBE (not recite character-by-character) file paths, identifiers,
# hashes, dates and long numbers that show up in a tool result.
REALTIME_LANGUAGE=he

# TOOL_WAIT_TIMEOUT_MS: deadline (ms) a committed turn's tool-call round trip
# is allowed before it force-fails. Read by _settings.py; a later task wires
# it into the floor's per-stage deadline machinery (mirrors how
# VAD_MAX_TURN_MS landed as a settings-side read before a later task
# consumed it). 120000 (2 minutes) here vs. the English deployment's in-code
# default of 60000 — a Hebrew tool-using turn may itself cross a Hebrew
# STT/TTS hop, so the deadline is more generous. Clamped to >=1000 in
# _settings.py: a non-positive value would force-fail every tool call
# instantly.
TOOL_WAIT_TIMEOUT_MS=120000

# OPENAI_MODEL: the voice-lane generate model. APPROVED DEVIATION d1
# (hebrew-realtime plan, 2026-09-18): the Hebrew voice lane is Gemma 4
# `senses` (alias `multimodal`), hosted LOCALLY — NOT `associate`, which the
# plan's original text named (associate is not what this deployment hosts).
# `multimodal` is also the realtime bridge's own hardcoded voice-lane
# default (lobes/realtime/_conversation.py's DEFAULT_VOICE_MODEL) — this
# line makes that choice explicit for the Hebrew deployment rather than
# relying on the empty-string gateway-default-routing fallback the English
# env.audio.example uses. Set this to a different lane (e.g. `cortex`) only
# to trade the ~1s multimodal latency for full reasoning.
OPENAI_MODEL=multimodal

# PHONIKUD_MODEL_PATH: path to the phonikud Hebrew diacritizer model,
# consumed by lobes/realtime/tts_client.py (hebrew-realtime t9). Leave empty
# to disable vocalization — Chatterbox then speaks undiacritized Hebrew
# text, which is legible but more ambiguous than vocalized text.
PHONIKUD_MODEL_PATH=

# TTS_DEBUG_TEXT: truthy (1/true/yes) logs the vocalized text actually sent
# to TTS (lobes/realtime/_vocalize.py) — useful when tuning Hebrew
# vocalization/gershayim handling. Leave empty/off in normal operation.
TTS_DEBUG_TEXT=
